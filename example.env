DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://x-realtors.in
DB_ENGINE=django.db.backends.postgresql
DB_NAME=heyday_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENVIRONMENT=SANDBOX
CONTACT_API_KEY_HEYDAY=your-heyday-api-key
CONTACT_API_KEY_CODIQ=your-codiq-api-key

# Storage Configuration
# Set USE_S3_STORAGE=False for local development (files saved to media/ directory)
# Set USE_S3_STORAGE=True for production (files uploaded to S3/Storj)
# If not set, defaults to True when AWS credentials are present
USE_S3_STORAGE=False

# AWS/Storj S3 Configuration (required only when USE_S3_STORAGE=True)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_ENDPOINT_URL=https://gateway.storjshare.io
AWS_S3_REGION_NAME=us-east-1
AWS_PROPERTY_BUCKET_NAME=heyday-property
AWS_AGENT_BUCKET_NAME=heyday-agent
AWS_CUSTOMER_BUCKET_NAME=heyday-customer
AWS_ADMIN_BUCKET_NAME=heyday-admin
AWS_STORAGE_BUCKET_NAME=heyday-admin
